---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="페이지를 찾을 수 없어요" noindex={true} canonicalPath="/404/">
  <div class="reading center" style="padding:60px 20px">
    <h1 class="section-title">찾는 페이지가 없어요</h1>
    <p class="muted">주소가 바뀌었거나 삭제된 지점일 수 있어요.</p>
    <div style="display:flex;gap:8px;justify-content:center;margin-top:18px;flex-wrap:wrap">
      <a class="btn" href="/">전국 지점 보기</a>
      <button class="btn ghost" type="button" data-search-open>지점 검색</button>
    </div>
  </div>
</BaseLayout>

<style>.reading{max-width:640px;margin:0 auto;}</style>
