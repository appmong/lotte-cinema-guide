---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { byRegion, CINEMAS } from "../../lib/cinemas";
import { SITE } from "../../site.config";

const groups = byRegion();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "전국 롯데시네마", item: new URL("/", SITE.url).href },
      { "@type": "ListItem", position: 2, name: "지역별 지점", item: new URL("/지역/", SITE.url).href },
    ],
  },
];
---

<BaseLayout
  title="지역별 롯데시네마 지점"
  description={`전국 ${CINEMAS.length}개 롯데시네마 지점을 지역별로 찾아보세요.`}
  canonicalPath="/지역/"
  jsonLd={jsonLd}
>
  <div class="container-wide">
    <nav class="breadcrumb-bar" aria-label="위치 경로">
      <a href="/">전국 롯데시네마</a> › <span>지역별 지점</span>
    </nav>
    <h1 class="section-title" style="margin-top:12px">지역별 롯데시네마 지점</h1>
    <p class="muted small" style="margin:0 0 20px">전국 {CINEMAS.length}개 지점 · {groups.length}개 지역</p>

    {groups.map((g) => (
      <section class="region-block">
        <div class="region-head">
          <h2><a href={`/지역/${g.region}/`}>{g.region}</a></h2>
          <span class="count">{g.cinemas.length}개 지점</span>
        </div>
        <div class="cinema-grid">
          {g.cinemas.map((c) => (
            <a class="cinema-card" href={c.url}>
              <div class="cc-name">{c.name}</div>
              <div class="cc-addr">{c.address}</div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
