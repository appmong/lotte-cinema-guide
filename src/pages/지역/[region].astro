---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { REGIONS, byRegion } from "../../lib/cinemas";
import { SITE, OFFICIAL, DISCLAIMER } from "../../site.config";

export function getStaticPaths() {
  return byRegion().map((g) => ({
    params: { region: g.region },
    props: { region: g.region, cinemas: g.cinemas },
  }));
}

const { region, cinemas } = Astro.props as {
  region: string;
  cinemas: import("../../lib/cinemas").Cinema[];
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "전국 롯데시네마", item: new URL("/", SITE.url).href },
      { "@type": "ListItem", position: 2, name: "지역별 지점", item: new URL("/지역/", SITE.url).href },
      { "@type": "ListItem", position: 3, name: region, item: new URL(`/지역/${region}/`, SITE.url).href },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: `${region} 롯데시네마 지점`,
    numberOfItems: cinemas.length,
    itemListElement: cinemas.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `${c.name} 롯데시네마`,
      url: new URL(c.url, SITE.url).href,
    })),
  },
];
---

<BaseLayout
  title={`${region} 롯데시네마 상영시간표`}
  description={`${region} 지역 롯데시네마 ${cinemas.length}개 지점의 위치·주차·예매·관람료 안내. 실시간 상영시간표는 공식 홈페이지로 연결됩니다.`}
  canonicalPath={`/지역/${region}/`}
  jsonLd={jsonLd}
>
  <div class="container-wide">
    <nav class="breadcrumb-bar" aria-label="위치 경로">
      <a href="/">전국 롯데시네마</a> › <a href="/지역/">지역별</a> › <span>{region}</span>
    </nav>
    <h1 class="section-title" style="margin-top:12px">{region} 롯데시네마 상영시간표</h1>
    <p class="muted small" style="margin:0 0 8px">{region} 지역 {cinemas.length}개 지점</p>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 24px">
      <a class="btn" href={OFFICIAL.schedule} target="_blank" rel="nofollow noopener">공식 상영시간표</a>
      <button class="btn ghost" type="button" data-search-open data-search-q={region}>다른 지점 검색</button>
    </div>

    <div class="cinema-grid">
      {cinemas.map((c) => (
        <a class="cinema-card" href={c.url}>
          <div class="cc-name">{c.name}</div>
          <div class="cc-addr">{c.address}</div>
          <div class="cc-meta">
            {c.screenCount && <span>{c.screenCount}개관</span>}
            {c.seatCount && <span>{c.seatCount}석</span>}
          </div>
        </a>
      ))}
    </div>

    <div class="disclaimer" style="margin:28px 0 32px">
      <strong>안내</strong> — {DISCLAIMER}
    </div>
  </div>
</BaseLayout>

<script></script>
